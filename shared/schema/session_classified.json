{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionClassified",
  "description": "세션 최종 순위표(Final Classification)가 확정됐을 때 Agent가 세션당 한 번 보내는 자기 완결적 이벤트(D-28). Session 맥락(모드·링크 식별자·트랙)과 Participants(이름·팀·AI 여부)를 carIndex로 합쳐 담는다. enum 값은 문자열이며, Backend는 대소문자를 무시하고 모르는 값은 0번 값(Other/Unknown)으로 받아들인다. Time Trial 세션은 보내지 않는다(D-30).",
  "type": "object",
  "required": [
    "sessionRef", "trackId", "sessionType", "sessionKind", "gameMode",
    "seasonLinkId", "weekendLinkId", "sessionLinkId",
    "totalLaps", "aiDifficulty", "isNetworkGame", "results"
  ],
  "properties": {
    "sessionRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "description": "결과를 받은 게임 세션 UID(F1 SessionUID의 10진 문자열). 같은 sessionRef로는 한 번만 보낸다."
    },
    "trackId": {
      "type": "integer",
      "description": "게임 UDP에서 제공하는 원시 트랙 ID"
    },
    "sessionType": {
      "type": "string",
      "enum": ["Unknown", "TimeTrial", "Practice", "Qualifying", "Race"],
      "description": "게임중립 세션 유형(기존 5종). TimeTrial은 보내지 않는다."
    },
    "sessionKind": {
      "type": "string",
      "enum": [
        "Unknown", "Practice1", "Practice2", "Practice3", "ShortPractice",
        "Qualifying1", "Qualifying2", "Qualifying3", "ShortQualifying", "OneShotQualifying",
        "SprintShootout1", "SprintShootout2", "SprintShootout3", "ShortSprintShootout", "OneShotSprintShootout",
        "Race", "Race2", "Race3", "TimeTrial"
      ],
      "description": "세션 상세 종류"
    },
    "gameMode": {
      "type": "string",
      "enum": [
        "Other", "DriverCareer", "MyTeamCareer", "OnlineCareer", "ChallengeCareer",
        "GrandPrix", "TimeTrial", "Online", "Story"
      ],
      "description": "게임 모드. 커리어 4종과 GrandPrix에서 링크 식별자가 모두 0이 아니면 시즌·주말에 묶인다(D-29)."
    },
    "seasonLinkId": {
      "type": "integer",
      "minimum": 0,
      "description": "게임의 SeasonLinkIdentifier(uint). 0이면 시즌 없음."
    },
    "weekendLinkId": {
      "type": "integer",
      "minimum": 0,
      "description": "게임의 WeekendLinkIdentifier(uint). 0이면 시즌 없음."
    },
    "sessionLinkId": {
      "type": "integer",
      "minimum": 0,
      "description": "게임의 SessionLinkIdentifier(uint). 0이면 세션 키를 sessionRef로 만든다(uid:{sessionRef})."
    },
    "totalLaps": {
      "type": "integer",
      "minimum": 0,
      "description": "세션의 총 랩 수"
    },
    "aiDifficulty": {
      "type": "integer",
      "minimum": 0,
      "description": "AI 난이도"
    },
    "isNetworkGame": {
      "type": "boolean",
      "description": "온라인(네트워크) 세션 여부"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "description": "차 1대당 1건의 최종 결과. isPlayer는 최대 1대, carIndex는 중복 없이 0~31.",
      "items": {
        "type": "object",
        "required": [
          "carIndex", "isPlayer", "position", "gridPosition", "numLaps", "points",
          "numPitStops", "numPenalties", "resultStatus",
          "bestLapTimeMs", "totalRaceTimeMs", "penaltiesTimeMs",
          "driverName", "gameDriverId", "teamId", "raceNumber", "isAiControlled", "tyreStints"
        ],
        "properties": {
          "carIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31,
            "description": "세션 안의 차 번호(0부터)"
          },
          "isPlayer": {
            "type": "boolean",
            "description": "이 PC 플레이어의 차인지 여부"
          },
          "position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32,
            "description": "최종 순위(1부터)"
          },
          "gridPosition": { "type": "integer", "minimum": 0, "description": "출발 그리드 순위" },
          "numLaps": { "type": "integer", "minimum": 0, "description": "완주한 랩 수" },
          "points": { "type": "integer", "minimum": 0, "description": "이 세션에서 얻은 점수" },
          "numPitStops": { "type": "integer", "minimum": 0 },
          "numPenalties": { "type": "integer", "minimum": 0 },
          "resultStatus": {
            "type": "string",
            "enum": ["Unknown", "Active", "Finished", "DidNotFinish", "Disqualified", "NotClassified", "Retired"]
          },
          "bestLapTimeMs": {
            "type": "integer",
            "minimum": 0,
            "description": "베스트 랩(밀리초). 0 = 기록 없음."
          },
          "totalRaceTimeMs": {
            "type": "integer",
            "minimum": 0,
            "description": "총 레이스 시간(밀리초, 패널티 제외). 0 = 없음."
          },
          "penaltiesTimeMs": {
            "type": "integer",
            "minimum": 0,
            "description": "패널티 시간(밀리초)"
          },
          "driverName": {
            "type": ["string", "null"],
            "maxLength": 64,
            "description": "드라이버 이름. 참가자 정보를 받지 못했으면 null. Backend가 앞뒤 공백을 지우고 비면 null로 저장한다."
          },
          "gameDriverId": {
            "type": ["integer", "null"],
            "description": "게임 드라이버 ID. 사람(네트워크) 드라이버면 null."
          },
          "teamId": {
            "type": ["integer", "null"],
            "description": "게임 팀 ID"
          },
          "raceNumber": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "차 번호"
          },
          "isAiControlled": {
            "type": "boolean"
          },
          "tyreStints": {
            "type": "array",
            "maxItems": 8,
            "description": "타이어 스틴트(교체 순서). 비어 있을 수 있다.",
            "items": {
              "type": "object",
              "required": ["endLap", "visualCompound", "actualCompound"],
              "properties": {
                "endLap": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "그 스틴트가 끝난 랩"
                },
                "visualCompound": {
                  "type": "string",
                  "enum": ["Unknown", "Soft", "Medium", "Hard", "Intermediate", "Wet"],
                  "description": "화면용 컴파운드"
                },
                "actualCompound": {
                  "type": ["string", "null"],
                  "maxLength": 10,
                  "description": "게임 중립 문자열 라벨(예: C3)"
                }
              }
            }
          }
        }
      }
    }
  }
}
