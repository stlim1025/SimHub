    <None Include="Seasons\Import\Fixtures\*.md" CopyToOutputDirectory="PreserveNewest" Link="Fixtures\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SimCenter.Application\SimCenter.Application.csproj" />
  </ItemGroup>

