<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\simhub.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 트레이·창 아이콘 원본(exe 아이콘과 같은 파일). App.xaml.cs가 LogicalName으로 읽는다. -->
    <EmbeddedResource Include="Assets\simhub.ico" LogicalName="SimCenter.Agent.Tray.simhub.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimCenter.Agent.Core\SimCenter.Agent.Core.csproj" />
    <ProjectReference Include="..\SimCenter.Agent.Infrastructure\SimCenter.Agent.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
