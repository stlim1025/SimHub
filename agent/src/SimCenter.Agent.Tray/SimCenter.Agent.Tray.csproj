<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\simhub.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 트레이·창 아이콘 원본(exe 아이콘과 같은 파일). App.xaml.cs가 LogicalName으로 읽는다. -->
    <EmbeddedResource Include="Assets\simhub.ico" LogicalName="SimCenter.Agent.Tray.simhub.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimCenter.Agent.Core\SimCenter.Agent.Core.csproj" />
    <ProjectReference Include="..\SimCenter.Agent.Infrastructure\SimCenter.Agent.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

  <!--
    기본 설정은 exe 안에 넣는다(배포물은 exe 하나). 배포 스크립트는 -p:AgentSettingsFile=<운영 설정>으로 다른 파일을 넣는다.
    exe 옆에 appsettings.json을 두면 그 값이 내장 설정보다 우선한다(App.xaml.cs).
  -->
  <PropertyGroup>
    <AgentSettingsFile Condition="'$(AgentSettingsFile)' == ''">appsettings.json</AgentSettingsFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(AgentSettingsFile)" LogicalName="SimCenter.Agent.Tray.appsettings.json" />
  </ItemGroup>

</Project>
